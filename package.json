{
  "name": "pokepet-explorer",
  "productName": "PokePet Explorer",
  "version": "0.1.0",
  "description": "A pixel Pokémon desktop pet with QQ-Pet style raising, plus Pomodoro timer and to-dos (English / 中文).",
  "author": "Rio's Kitchen",
  "main": "main.js",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "icon": "node tools/make-icon.js",
    "preview-sprites": "node tools/preview-sprites.js",
    "dist:mac": "node tools/make-icon.js && electron-builder --mac && node tools/clean-install.js",
    "dist:win": "node tools/make-icon.js && electron-builder --win && node tools/clean-install.js",
    "dist": "node tools/make-icon.js && electron-builder --mac --win && node tools/clean-install.js"
  },
  "build": {
    "appId": "local.pokepetexplorer.app",
    "productName": "PokePet Explorer",
    "directories": {
      "output": "install",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "PokePetExplorer-${version}-macOS.${ext}",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "PokePet Explorer ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PokePetExplorer-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PokePet Explorer"
    },
    "copyright": "Copyright © 2026 Rio's Kitchen"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0"
  }
}
